  "glossary": [
    {
      "term": "会员档案",
      "en": "Member Archive / member",
      "where": "api/memberManage/_local/archive.js",
      "note": "一个会员一份主档：会员编号、姓名、类型（个人/企业）、手机号、证件、开户信息、三个状态位。所有会员动作最终都要回到这份主档上改状态。"
    },
    {
      "term": "会员编号",
      "en": "memberNo（M+6 位）",
      "where": "memberNo",
      "note": "业务主键，不是数据库主键。钱包、积分、认证单、注销单、绑卡记录都靠它挂到会员身上。"
    },
    {
      "term": "注册申请单",
      "en": "Register Apply / applyNo",
      "where": "register.js",
      "note": "会员先提交申请，主管审核通过才生成档案。是「申请单驱动建档」而不是「注册即建档」。"
    },
    {
      "term": "注册配置",
      "en": "Register Rule",
      "where": "register.js:27",
      "note": "控制三件事：是否开放注册、注册是否需审批、开放范围（个人/企业）。保存即生效，不走审批。"
    },
    {
      "term": "认证申请单",
      "en": "Cert Apply / certNo",
      "where": "certify.js",
      "note": "certType 1=实名认证（个人），2=企业认证。注册审核通过后自动生成，避免会员再单独发起一次。"
    },
    {
      "term": "实名认证状态 / 企业认证状态",
      "en": "realNameStatus / corpStatus",
      "where": "archive.js 种子",
      "note": "0 未认证 / 1 通过 / 2 审核中 / 3 驳回。认证单审核结论必须回写到这两个字段，否则页面显示和单据会打架。"
    },
    {
      "term": "账户状态",
      "en": "accountStatus",
      "where": "archive.js",
      "note": "1 正常 / 2 已冻结 / 3 已注销。注销完成后落在这里，不是物理删除。"
    },
    {
      "term": "注销缓冲期",
      "en": "bufferDeadline",
      "where": "cancel.js",
      "note": "提交注销后先不生效，给一个截止时间；期内会员可撤回，到期才真正关户。"
    },
    {
      "term": "绑卡信息",
      "en": "BindingCardInfo / tbl_binding_card_info",
      "where": "BindingCardInfoEntity.java",
      "note": "全平台一张表存所有绑卡：卡号、商户号 mid、平台商户号 innerMchtNo、签约协议号 contractId、签约通道 contractChnl、签约状态 contract_status。"
    },
    {
      "term": "签约状态",
      "en": "contract_state / ContractStatus",
      "where": "UmsSignServiceHandler.java:83",
      "note": "决定这张卡能不能直接代扣。签约应答里有 contractSignedTime 才算成功，否则记为未知，后续要查询补状态。"
    },
