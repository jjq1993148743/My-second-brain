{"post_stream":{"posts":[{"id":35734038,"username":"Russ2050","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/r/006699/{size}.png","created_at":"2024-06-25T11:58:54.624Z","cooked":"\u003cp\u003eMy kid wants to take individual tutoring for the ACT for the first time. She has taken the SAT through a provider and didn’t think highly of it. However, the hourly rates for individual tutoring are about 200-300 per hour or 45 minutes. We were planning on 10+ sessions.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eList item\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eHas anyone taken these lessons, and do they help, given that they are expensive?\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eList item\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eAre there any other options that work but cost less? Please DM me if you have personal recommendations.\u003c/p\u003e\n\u003cp\u003eThanks in advance!\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T11:58:54.624Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":256,"reads":82,"readers_count":81,"score":1296.4,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":1340583,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/1","event":null,"calendar_details":[],"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":35734041,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2024-06-25T12:03:16.655Z","cooked":"","post_number":2,"post_type":3,"posts_count":9,"updated_at":"2024-06-25T12:03:16.655Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":6,"reads":81,"readers_count":80,"score":46.2,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":false,"staff":true,"user_id":1186233,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"action_code":"closed.enabled","post_url":"/t/individual-tutoring-act/3668984/2","event":null,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734042,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2024-06-25T12:04:16.609Z","cooked":"\u003cp\u003eReminder that CC is not a referral service and recommendations for specific tutors/programs are not allowed.\u003c/p\u003e","post_number":3,"post_type":2,"posts_count":9,"updated_at":"2024-06-25T12:04:20.858Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":19,"reads":82,"readers_count":81,"score":126.4,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":true,"admin":false,"staff":true,"user_id":1186233,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/3","event":null,"reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734043,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2024-06-25T12:04:33.109Z","cooked":"","post_number":4,"post_type":3,"posts_count":9,"updated_at":"2024-06-25T12:04:33.109Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":15,"reads":80,"readers_count":79,"score":91.0,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":false,"staff":true,"user_id":1186233,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"action_code":"closed.disabled","post_url":"/t/individual-tutoring-act/3668984/4","event":null,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734086,"username":"tsbna44","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/t/006699/{size}.png","created_at":"2024-06-25T13:08:40.969Z","cooked":"\u003cp\u003eWe went through a local test prep franchise. 6 1x1 sessions. 6 and 4 years ago.  Was $90 an hr I think - maybe 6 sessions. They set the # of terms. We didn’t. I think 60 or 90 mins each. Cost may be higher in a higher cost area.\u003c/p\u003e\n\u003cp\u003eAlso a local test prep place may have group classes that are less - YMMV. Mine would not do as well with those.\u003c/p\u003e\n\u003cp\u003eOr have your kid do a practice test. Do they score a 34-36 on any section ?  Depending on their school list, maybe you can reduce the amount of tutoring if they’ve already mastered a section.\u003c/p\u003e\n\u003cp\u003eEveryone handles prep differently. Some do well 1x1.  For some it’s not the right method. Some study alone better (maybe using online tools or a book).  Some grasp or don’t grasp the concepts better in this form.\u003c/p\u003e\n\u003cp\u003eSome struggle with the test or section that day just because it’s harder regardless of prep. My kid followed a 31 in one section with a 24 the next time.\u003c/p\u003e\n\u003cp\u003eMany will say to look at khan academy. We didn’t but it’s free and online.\u003c/p\u003e\n\u003cp\u003eSome high schools may have test prep sessions after school or on Saturdays. Others do well studying from a test prep book you’d find at the library or on Amazon.\u003c/p\u003e\n\u003cp\u003eDepends on how your kid learns best. It may be a combo of ways.\u003c/p\u003e\n\u003cp\u003eYou may find a lower cost alternative at a local college (student or faculty) or through local recommendation from last year’s patents. Maybe a teacher at another school or ex teacher has a side hustle at $50 an hour.\u003c/p\u003e\n\u003cp\u003eLots of things to look at.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T13:17:15.653Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":32,"reads":71,"readers_count":70,"score":204.2,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":"ParentsHS2025","flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":1360504,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/5","event":null,"reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734094,"username":"DadTwoGirls","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/d/006699/{size}.png","created_at":"2024-06-25T13:23:43.706Z","cooked":"\u003cp\u003eOur experience was similar to \u003ca class=\"mention\" href=\"/u/tsbna44\"\u003e@tsbna44\u003c/a\u003e.  We used a local company that as far as I was able to tell consisted of a total of 3 people – two tutors plus one receptionist. This did not require many sessions and seemed to make at least one daughter quite a bit more confident going into the SAT. One daughter also took a small group class at a local community center. This was very economical. The total cost in both cases was under $1,000, and in at least one case quite a bit less than this (probably more like $100 for a few group classes).\u003c/p\u003e\n\u003cp\u003eWe also know someone who does SAT tutoring. In this case there isn’t a company, there is just one retired teacher who does tutoring. Again the cost is quite reasonable.\u003c/p\u003e\n\u003cp\u003eI would try to find someone local, wherever you live.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T13:23:43.706Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":22,"reads":66,"readers_count":65,"score":138.2,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1095504,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/6","event":null,"reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734095,"username":"twogirls","avatar_template":"/user_avatar/talk.collegeconfidential.com/twogirls/{size}/264825_2.png","created_at":"2024-06-25T13:23:53.662Z","cooked":"\u003cp\u003eMy daughter had individual tutoring for both the SAT and the ACT. At the time it was $100 a session, but that was years ago.\u003c/p\u003e\n\u003cp\u003eHas your child taken a baseline test? That may determine how much tutoring they need…or what the tutoring would actually accomplish in terms of an increase in score. A baseline of 32 may only need 2 weeks of tutoring to get the hang of the test and an increase of 2-3 points. On the other hand…10 weeks of tutoring likely will not move a 24 up to a 35. There is a point where they test where they test…\u003c/p\u003e\n\u003cp\u003eI would begin with a baseline test and then determine from there. It does get very expensive and a good tutor will tell you when to stop.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T13:30:38.565Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":21,"reads":65,"readers_count":64,"score":148.0,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":542435,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/7","event":null,"reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734116,"username":"BKSquared","avatar_template":"/user_avatar/talk.collegeconfidential.com/bksquared/{size}/257_2.png","created_at":"2024-06-25T13:51:39.978Z","cooked":"\u003cp\u003eI would start with why does your kid need a tutor?\u003c/p\u003e\n\u003cp\u003eIs it creating a structure where they are forced into blocks of time for instruction and practice?  If this is the case, a “group” session may be as effective and more economical.\u003c/p\u003e\n\u003cp\u003eAre there weaknesses in particular parts of the test:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eIs this  a comprehension or speed issue (speed is extra critical for the ACT)?\u003c/li\u003e\n\u003cli\u003eAre they getting easy questions wrong because they misread the questions or were careless?\u003c/li\u003e\n\u003cli\u003eAre they missing the hard questions because they are unfamiliar with the substance?\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eMost competent tutors can handle speed and tactical issues.  Teaching Alg2/Trig concepts effectively is going to require someone with true teaching/communication skills.  I would ask around friends who also had private tutors for older children for recommendations.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T13:51:39.978Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":16,"reads":63,"readers_count":62,"score":92.6,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":"ForumChampYale","flair_name":"ForumChampYale","flair_url":null,"flair_bg_color":"","flair_color":"","flair_group_id":66,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Forum Champion Yale","title_is_group":true,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":1080098,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/8","event":null,"reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734191,"username":"Crosbylane","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/006699/{size}.png","created_at":"2024-06-25T15:06:38.979Z","cooked":"\u003cp\u003eSo, for my older two, I paid a more expensive price for private tutoring, with only fair results. With my youngest, I did it differently/less expensively with the best results. She took the ACT early for a baseline, and then worked with a local teacher (side hustle and WAY less than professional tutoring company- our high school’s guidance office had a list of teachers who tutored) very inexpensively to do practice timed sections that she needed to bring up. The teacher would score it, they’d go over what she did wrong/didn’t understand, and repeat. This, coupled with my daughter taking practice tests on her own at home (for only the sections she wanted to raise), worked great and if I had another child, we’d definitely go this route again. It may be somewhat student dependent, but IMHO, paying for expensive test prep/tutoring is not necessarily needed.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T15:26:01.103Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":19,"reads":58,"readers_count":57,"score":136.6,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":1572260,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/9","event":null,"reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734194,"username":"Mjkacmom","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/m/006699/{size}.png","created_at":"2024-06-25T15:08:58.198Z","cooked":"\u003cp\u003eI hired tutors for my kids, but he only charged $75 an hour, found him through word of mouth and recommended him often on our town’s Facebook parent page (and I can see that many in town still use him based on Venmo transactions). My daughters who wanted to go oos needed decent scores for merit, one son wanted to go to an in state school where his 3.4 gpa was on the low end.\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":9,"updated_at":"2024-06-25T15:08:58.198Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":12,"reads":55,"readers_count":54,"score":86.0,"yours":false,"topic_id":3668984,"topic_slug":"individual-tutoring-act","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1230171,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/individual-tutoring-act/3668984/10","event":null,"reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35734490,"username":