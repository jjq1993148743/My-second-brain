{"post_stream":{"posts":[{"id":35328948,"username":"hoopsdad2000","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/h/006699/{size}.png","created_at":"2023-10-05T22:14:58.942Z","cooked":"\u003cp\u003eMy oldest sibling has received a summer internship offer from a Fortune 500 company.  It’s from a corporation halfway across the country in an industry that’s outside of her major (but she will be learning how to manage business relationships directly in her field of study.) The offer expires in 2 weeks and doesn’t really give her the opportunity to see “what else is out there.”\u003c/p\u003e\n\u003cp\u003eDD was offered $21/hr., 40-hr work week plus $7k signing bonus.  I am curious to know from parents of older college students and recent grads.  Is this a competitive offer for an internship?\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:14:58.942Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1989,"reads":272,"readers_count":271,"score":10039.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1249390,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/1","event":null,"calendar_details":[],"reactions":[{"id":"+1","type":"emoji","count":1},{"id":"tada","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":35328956,"username":"Lindagaf","avatar_template":"/user_avatar/talk.collegeconfidential.com/lindagaf/{size}/188557_2.png","created_at":"2023-10-05T22:22:42.605Z","cooked":"\u003cp\u003eThis seems extremely good to me.\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:22:42.605Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":26,"reads":262,"readers_count":261,"score":287.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":"Super_Moderators","flair_name":"Super_Moderators","flair_url":null,"flair_bg_color":"","flair_color":"","flair_group_id":15,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":7}],"moderator":true,"admin":false,"staff":true,"user_id":820664,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/2","event":null,"reactions":[{"id":"+1","type":"emoji","count":7}],"current_user_reaction":null,"reaction_users_count":7,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328959,"username":"thumper1","avatar_template":"/user_avatar/talk.collegeconfidential.com/thumper1/{size}/244_2.png","created_at":"2023-10-05T22:24:10.273Z","cooked":"\u003cp\u003eThe $7000 signing bonus hopefully can pay for a place for her to live!\u003c/p\u003e\n\u003cp\u003eThat sounds good to me.\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:24:10.273Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":27,"reads":262,"readers_count":261,"score":277.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Speech Language Pathologist","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":6}],"moderator":false,"admin":false,"staff":false,"user_id":9509,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/3","event":null,"reactions":[{"id":"+1","type":"emoji","count":6}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328961,"username":"worriedmomucb","avatar_template":"/user_avatar/talk.collegeconfidential.com/worriedmomucb/{size}/145758_2.png","created_at":"2023-10-05T22:24:19.938Z","cooked":"\u003cp\u003eWill she be able to pay her living expenses (possibly with you help)? Will she learn something of value and gain useful professional experience? If so, then yes. An internship is first and foremost for work experience. Yes, pay is important because everyone has bills. But if this is the experience she wants to have, then your question is answered.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:24:31.688Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":38,"reads":261,"readers_count":260,"score":317.2,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Senior Member","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":5}],"moderator":false,"admin":false,"staff":false,"user_id":1621934,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/4","event":null,"reactions":[{"id":"+1","type":"emoji","count":5},{"id":"100","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328964,"username":"coffeeat3","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/006699/{size}.png","created_at":"2023-10-05T22:25:52.681Z","cooked":"\u003cp\u003eI think it depends on the area she would be living - NYC or San Fran - that seems a bit low to me for a Fortune 500 Co. Are they providing her leads on housing with other interns or arranging for example some tech companies rent out dorm housing in high end housing areas?\u003cbr\u003e\nAre you willing to subsidize her housing for the experience ?  Lastly, what is the tax situation like in the city she would be interning in - will she now have a city and state tax to pay vs her current state of residence tax - not saying no, but all things to consider if the money is important vs the experience.\u003c/p\u003e\n\u003cp\u003eIs she going into her Sr year and was she hoping to intern at a company that would lead to a job offer after graduation - this doesn’t sound like what she would want - or is it? Is this jr/sr year summer - that is different and would be great to learn what the does and doesn’t want to do.\u003c/p\u003e\n\u003cp\u003eEither way - congrats to her for getting out there and landing an internship and having a decision to make!\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:31:49.978Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":50,"reads":258,"readers_count":257,"score":361.6,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":4}],"moderator":false,"admin":false,"staff":false,"user_id":1327597,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/5","event":null,"reactions":[{"id":"+1","type":"emoji","count":4}],"current_user_reaction":null,"reaction_users_count":4,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328975,"username":"eyemgh","avatar_template":"/user_avatar/talk.collegeconfidential.com/eyemgh/{size}/2301_2.png","created_at":"2023-10-05T22:35:21.455Z","cooked":"\u003cp\u003eInternship pay is highly dependent on industry.\u003c/p\u003e\n\u003cp\u003eAt the end of the day though it doesn’t really matter. It’s about how much she values that specific experience AND how excited she’d be to work for them as many internships are essentially extended interviews.\u003c/p\u003e\n\u003cp\u003eIf she’s excited, can break even, and, probably most important of all, doesn’t have something in hand that she likes better, she should take it.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:35:21.455Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":39,"reads":240,"readers_count":239,"score":468.0,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":13}],"moderator":false,"admin":false,"staff":false,"user_id":604037,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/6","event":null,"reactions":[{"id":"+1","type":"emoji","count":13}],"current_user_reaction":null,"reaction_users_count":13,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328984,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2023-10-05T22:43:52.953Z","cooked":"\u003cp\u003eI agree that salary is very dependent on industry.    For CS or engineering I would say that’s quite low and not competitive regardless of location.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:43:52.953Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":31,"reads":234,"readers_count":233,"score":276.8,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":fal