_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328990,"username":"helpingthekid73","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/h/006699/{size}.png","created_at":"2023-10-05T22:45:55.320Z","cooked":"\u003cp\u003ewow, S21 got $150 a week to work for a top arts organization last summer, that sounds amazing to me!\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:45:55.320Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":11,"reads":230,"readers_count":229,"score":191.0,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":"ParentsHS2024","flair_name":"ParentsHS2024","flair_url":"https://us1.discourse-cdn.com/collegeconfidential/original/3X/a/9/a978513a95d49910841c96142a96716fb462fa78.png","flair_bg_color":"","flair_color":"","flair_group_id":56,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Parent HS Class of 2024","title_is_group":true,"bookmarked":false,"actions_summary":[{"id":2,"count":6}],"moderator":false,"admin":false,"staff":false,"user_id":1363482,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/9","event":null,"reactions":[{"id":"+1","type":"emoji","count":6}],"current_user_reaction":null,"reaction_users_count":6,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328993,"username":"ucbalumnus","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/006699/{size}.png","created_at":"2023-10-05T22:49:32.346Z","cooked":"\u003cp\u003eIndustry and type of job matter in terms of how competitive the pay level is.\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:49:32.346Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":13,"reads":229,"readers_count":228,"score":170.8,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":425338,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/10","event":null,"reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35328995,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2023-10-05T22:50:01.252Z","cooked":"\u003cp\u003eI think it’s safe to say thats an outlier.\u003c/p\u003e\n\u003cp\u003eOP  - your student should go to the career center and ask for the average salary for internships in her field.  They should have that information.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:50:01.252Z","reply_count":0,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":19,"reads":226,"readers_count":225,"score":185.2,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"reply_to_user":{"id":741950,"username":"parentologist","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/p/006699/{size}.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":true,"admin":false,"staff":true,"user_id":1186233,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/11","event":null,"reactions":[{"id":"+1","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329005,"username":"ucla_cs_god","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/006699/{size}.png","created_at":"2023-10-05T22:59:00.219Z","cooked":"\u003cp\u003eDepends on the field. While I am not studying business, this seems pretty similar to what a business major friend got (he had slightly higher pay with no signing bonus, but virtual internship).\u003c/p\u003e\n\u003cp\u003eOne of the most valuable parts of my summer internship, even more so than the pay, was the opportunity to work in-person at an office, along full-time engineers. It seems that she will be getting that.\u003c/p\u003e\n\u003cp\u003eAlso, don’t forget that internships are trial runs of actual jobs. If she will be graduating soon, is this a company she will potentially want to work at? If she does well, they might want to offer her return.\u003c/p\u003e","post_number":12,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T22:59:00.219Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":30,"reads":224,"readers_count":223,"score":209.8,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Student Ambassador","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1389483,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/12","event":null,"reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329037,"username":"ClassicMom98","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/006699/{size}.png","created_at":"2023-10-05T23:28:07.268Z","cooked":"\u003cp\u003eYounger S last summer was just under $30/hr in the DC area for Intelligence Analysis. He lived with a roommates family and had no living expenses.\u003c/p\u003e\n\u003cp\u003eOlder S in 2019 has an internship in economics in Dallas for $25/hr.\u003c/p\u003e\n\u003cp\u003eSo $21 seems low to me?\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:28:07.268Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":23,"reads":212,"readers_count":211,"score":202.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":1258053,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/13","event":null,"reactions":[{"id":"+1","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329041,"username":"roycroftmom","avatar_template":"/user_avatar/talk.collegeconfidential.com/roycroftmom/{size}/177462_2.png","created_at":"2023-10-05T23:35:21.361Z","cooked":"\u003cp\u003eThe $ 7k  sign on bonus effectively raises her rate of pay to over $1500/ week, which is good. Many summer internships do not pay such a bonus. Having two weeks to decide is the norm\u003c/p\u003e","post_number":14,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:36:50.927Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":11,"reads":207,"readers_count":206,"score":251.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":10}],"moderator":false,"admin":false,"staff":false,"user_id":1057892,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/14","event":null,"reactions":[{"id":"+1","type":"emoji","count":10}],"current_user_reaction":null,"reaction_users_count":10,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329053,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png","created_at":"2023-10-05T23:51:26.729Z","cooked":"\u003cp\u003eDepending on location that $7k may not cover housing costs.\u003c/p\u003e","post_number":15,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:51:26.729Z","reply_count":1,"reply_to_post_number":14,"quote_count":0,"incoming_link_count":7,"reads":202,"readers_count":201,"score":125.4,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":"Super_Moderators","flair_name":"essay-readers","flair_url":"book-open","flair_bg_color":"f2a900","flair_color":"","flair_group_id":32,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Super Moderator","title_is_group":true,"reply_to_user":{"id":1057892,"username":"roycroftmom","avatar_template":"/user_avatar/talk.collegeconfidential.com/roycroftmom/{size}/177462_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":true,"admin":false,"staff":true,"user_id":1186233,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/15","event":null,"reactions":[{"id":"+1","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329054,"username":"roycroftmom","avatar_template":"/user_avatar/talk.collegeconfidential.com/roycroftmom/{size}/177462_2.png","created_at":"2023-10-05T23:53:23.300Z","cooked":"\u003cp\u003eIt may not. But it is still not the norm in most industries\u003c/p\u003e","post_number":16,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:53:23.300Z","reply_count":0,"reply_to_post_number":15,"quote_count":0,"incoming_link_count":9,"reads":203,"readers_count":202,"score":190.6,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":1186233,"username":"momofboiler1","avatar_template":"/user_avatar/talk.collegeconfidential.com/momofboiler1/{size}/261_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":5}],"moderator":false,"admin":false,"staff":false,"user_id":1057892,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/16","event":null,"reactions":[{"id":"+1","type":"emoji","count":5}],"current_user_reaction":null,"reaction_users_count":5,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329057,"username":"blossom","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/b/006699/{size}.png","created_at":"2023-10-05T23:54:54.682Z","cooked":"\u003cp\u003eThis is a great opportunity to encourage your D to educate herself about “Total Comp”.\u003c/p\u003e\n\u003cp\u003eThere’s her hourly wage.  There’s her sign on bonus.  There are possibly other benefits- subsidized public transportation or parking? free lunch? dinner if you work past 8 and paid Uber home?\u003c/p\u003e\n\u003cp\u003eShe should reach out to career services at her college to see if this package tracks with what they are seeing.  And she should reach out to her HR/Recruiting person at the company to see if they offer assistance finding housing (which is valuable in many parts of the company), etc.\u003c/p\u003e\n\u003cp\u003eSome colleges allow “exploding offers” and some do not.  She can check with career services to make sure that the two week window is an agreed upon timeframe with the college.\u003c/p\u003e\n\u003cp\u003eCongrats to her!\u003c/p\u003e","post_number":17,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:54:54.682Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":20,"reads":200,"readers_count":199,"score":250.0,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":5}],"moderator":false,"admin":false,"staff":false,"user_id":3836,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/17","event":null,"reactions":[{"id":"+1","type":"emoji","count":5}],"current_user_reaction":null,"reaction_users_count":5,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329058,"username":"roycroftmom","avatar_template":"/user_avatar/talk.collegeconfidential.com/roycroftmom/{size}/177462_2.png","created_at":"2023-10-05T23:56:20.455Z","cooked":"\u003cp\u003eEven in NYC and SF, a student sharing a place with a friend should be comfortably within budget. An airbnb can be rented for 4k per month and cost split.\u003cbr\u003e\nThe career services rules would apply only to offers acquired thru on campus recruiting, I believe\u003c/p\u003e","post_number":18,"post_type":1,"posts_count":81,"updated_at":"2023-10-05T23:57:42.494Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":20,"reads":195,"readers_count":194,"score":154.0,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1057892,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/18","event":null,"reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329065,"username":"Eeyore123","avatar_template":"/user_avatar/talk.collegeconfidential.com/eeyore123/{size}/250_2.png","created_at":"2023-10-06T00:06:41.962Z","cooked":"\u003cp\u003eIf it is a 10 week internship, the 7k is $17.50/hr. So 21 + 17.50 = $38.50/hr.\u003c/p\u003e","post_number":19,"post_type":1,"posts_count":81,"updated_at":"2023-10-06T00:06:41.962Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":17,"reads":189,"readers_count":188,"score":272.8,"yours":false,"topic_id":3647693,"topic_slug":"summer-internship-pay-rates","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":8}],"moderator":false,"admin":false,"staff":false,"user_id":1140994,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/summer-internship-pay-rates/3647693/19","event":null,"reactions":[{"id":"+1","type":"emoji","count":8},{"id":"bulb","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":9,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":35329074,"username":"eyemgh","avatar_template":"/user_avatar/talk.collegeconfidential.com/eyemgh/{size}/2301_2.png","created_at":"2023-10-06T00:22:39.536Z","cooked":"\u003caside class=\"quote no-group\" data-username=\"blossom\" data-post=\"17\" data-topic=\"3647693\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg loading=\"lazy\" alt=\"\" width=\"24\" height=\"24\" src=\"https://avatars.discourse-cdn.com/v4/letter/b/006699/48.png\" class=\"avatar\"\u003e blossom:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eAnd she should reach out to her HR/Recruiting person at the company to see if they offer assistance finding housing (which is valuable in many parts of the company), etc.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eTo expand on this very important point, it can be tough to find housing for just the summer. Any assistance she can get will be helpful.\u003c/p\u003e","post_number":20,"post_type":1,"posts_count":81,"updated_at":"2023-10-06T00:22:39.536Z","reply_count":0,"reply_to_post_number":17,"quote_count":